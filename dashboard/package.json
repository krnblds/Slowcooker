{
  "name": "slowcooker-dashboard",
  "private": true,
  "type": "module",
  "description": "Workspace for @slowcooker/vue (the component kit) and the admin app bundled with Slowcooker.AspNetCore",
  "workspaces": [
    "kit",
    "admin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev -w admin",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w kit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
