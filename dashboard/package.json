{
  "name": "slowcooker-dashboard",
  "private": true,
  "type": "module",
  "description": "Workspace for the Vue component kit (kit/, source only) and the admin app compiled into Slowcooker.AspNetCore (admin/)",
  "workspaces": [
    "kit",
    "admin"
  ],
  "scripts": {
    "build": "npm run build -w admin",
    "dev": "npm run dev -w admin",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w kit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.1.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
