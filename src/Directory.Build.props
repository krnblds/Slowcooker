<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Everything under src/ ships as a NuGet package with XML docs, the README and the icon. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public members without a doc comment are allowed; the docs folder is the reference. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Default description; packages override it in their csproj. -->
    <Description>Slowcooker: typed background jobs for .NET with Postgres, Redis or in-memory storage, retries, cron schedules and a bundled dashboard.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../docs/assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
