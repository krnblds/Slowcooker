<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>

    <!-- Version of every package. Releases pass -p:Version=x.y.z from the git tag (see .github/workflows/release.yml). -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <Authors>Slowcooker contributors</Authors>
    <Product>Slowcooker</Product>
    <Copyright>Copyright (c) Slowcooker contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/krnblds/Slowcooker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/krnblds/Slowcooker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>background-jobs;jobs;queue;scheduler;cron;postgres;redis;hangfire;dashboard</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Reproducible, debuggable packages: deterministic builds, Source Link, symbols next to the package. -->
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
