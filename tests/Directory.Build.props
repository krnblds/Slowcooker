<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are executables running on Microsoft.Testing.Platform (see global.json). -->
    <OutputType>Exe</OutputType>
    <!-- xunit analyzers are noisy about Task.Delay and blocking waits in tests. -->
    <NoWarn>$(NoWarn);xUnit1030;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'false'">
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
